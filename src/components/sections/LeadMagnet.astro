---
import Card from '../ui/Card.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import ContactForm from '../islands/ContactForm.tsx';

const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';
---

<section id="recurso">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <SectionLabel index="09" text="CHECKLIST" />

    <h2 class="mt-6 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">
      Checklist: 27 puntos para modernizar tu sistema legacy
    </h2>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-6">
        <p class="text-navy-900">
          27 puntos concretos para auditar tu sistema actual, directo a tu correo.
        </p>
      </div>

      <div class="lg:col-span-6">
        <Card class="p-6 lg:p-8">
          <ContactForm client:visible endpoint={endpoint} />
        </Card>
        <p class="mt-4 font-mono text-xs tracking-wider text-steel-500 uppercase">
          Captación automatizada con n8n (nuestro caso #0).
        </p>
      </div>
    </div>
  </div>
</section>
