---

<section id="stack" class="border-y border-line">
  {/* Sprite de iconos monocromos (Simple Icons, inline) */}
  <svg aria-hidden="true" focusable="false" class="absolute h-0 w-0 overflow-hidden">
    {
      stack.map((item) => (
        <symbol id={item.icon} viewBox="0 0 24 24">
          <path d={item.path} fill="currentColor" />
        </symbol>
      ))
    }
  </svg>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
    <SectionLabel index="03" text="STACK" />

    <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h2 class="text-sm font-bold tracking-widest text-navy-900 uppercase">STACK DE PRODUCCIÓN</h2>
      <p class="text-sm text-steel-500 italic">Tecnología elegida por resultados, no por moda.</p>
    </div>
  </div>

  {/* Cuadrícula técnica de celdas con enlaces oficiales (full-bleed) */}
  <ul data-motion="stack-power" class="grid grid-cols-2 border-t border-line sm:grid-cols-4 lg:grid-cols-8">
    {
      stack.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visitar sitio oficial de ${item.name}`}
            class="group flex h-full items-center gap-2.5 border-r border-b border-line px-4 py-4 transition-colors hover:border-navy-900/30 focus-visible:outline-offset-[-2px]"
          >
            <svg
              class="size-5 shrink-0 text-steel-500 transition-colors group-hover:text-navy-900"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <use href={`#${item.icon}`} />
            </svg>
            <span class="font-mono text-xs tracking-wider text-steel-500 uppercase transition-colors group-hover:text-navy-900">
              {item.name}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
