---
import SectionLabel from '../ui/SectionLabel.astro';

interface StackCategory {
  label: string;
  items: string[];
}

const categories: StackCategory[] = [
  {
    label: '[ BACKEND ]',
    items: ['Spring Boot', 'NestJS', 'FastAPI'],
  },
  {
    label: '[ FRONTEND ]',
    items: ['Angular 21', 'React', 'Vue 3'],
  },
  {
    label: '[ INFRA & CLOUD ]',
    items: ['AWS (Serverless)', 'Docker', 'Terraform (IaC)'],
  },
  {
    label: '[ AI & DATA ]',
    items: ['LangChain / Genkit', 'RAG Architectures', 'Agentic Workflows'],
  },
];
---

<section id="stack" class="border-y border-line">
  <div class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
    <SectionLabel index="03" text="ECOSISTEMA TÉCNICO" />

    <h2 class="mt-6 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Tecnología seleccionada por rendimiento y escalabilidad.</h2>

    <div data-motion="stack-power" class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        categories.map((category) => (
          <div>
            <p class="font-mono text-xs tracking-[0.18em] text-steel-500 uppercase">{category.label}</p>
            <ul class="mt-4 flex flex-col gap-2">
              {category.items.map((item) => (
                <li class="flex gap-2 text-navy-900">
                  <span aria-hidden="true" class="text-steel-500">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div data-motion="stack-message" class="mt-14 border-t border-navy-900/10 pt-8">
      <p class="text-center font-mono text-xs tracking-[0.18em] text-navy-900/50 uppercase">¿NO VES TU STACK AQUÍ?</p>
      <p class="mx-auto mt-3 max-w-2xl text-center text-lg text-navy-900">Mi perfil es de ingeniero. Mi valor radica en diseñar sistemas robustos; las herramientas cambian, los fundamentos, arquitecturas y las buenas prácticas permanecen.</p>
    </div>
  </div>
</section>
