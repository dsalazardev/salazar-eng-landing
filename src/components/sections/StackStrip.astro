const stack = categories.flatMap((category) => category.items);
---

<section id="stack" class="border-y border-line">
  {/* Sprite de iconos monocromos (Simple Icons, inline) */}
  <svg aria-hidden="true" focusable="false" class="absolute h-0 w-0 overflow-hidden">
    {
      stack.map((item) => (
        <symbol id={item.icon} viewBox="0 0 24 24">
          <path d={item.path} fill="currentColor" />
        </symbol>
      ))
    }
  </svg>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
    <SectionLabel index="03" text="ECOSISTEMA TÉCNICO" />

    <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <p class="text-sm text-steel-500 italic">Tecnología seleccionada por rendimiento y escalabilidad.</p>
    </div>
  </div>

  {/* Cuadrícula técnica de 4 categorías con celdas de icono + enlace (full-bleed) */}
  <div data-motion="stack-power" class="grid border-t border-line sm:grid-cols-2">
    {
      categories.map((category) => (
        <div>
          <p class="tech-label border-r border-b border-line px-4 py-4">{category.label}</p>
          <ul class="grid grid-cols-3">
            {category.items.map((item) => (
              <li>
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visitar sitio oficial de ${item.name}`}
                    class="group flex h-full items-center gap-2.5 border-r border-b border-line px-4 py-4 transition-colors hover:border-navy-900/30 focus-visible:outline-offset-[-2px]"
                  >
                    <svg
                      class="size-5 shrink-0 text-steel-500 transition-colors group-hover:text-navy-900"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <use href={`#${item.icon}`} />
                    </svg>
                    <span class="font-mono text-xs tracking-wider text-steel-500 uppercase transition-colors group-hover:text-navy-900">
                      {item.name}
                    </span>
                  </a>
                ) : (
                  <div class="group flex h-full items-center gap-2.5 border-r border-b border-line px-4 py-4 transition-colors hover:border-navy-900/30">
                    <svg
                      class="size-5 shrink-0 text-steel-500 transition-colors group-hover:text-navy-900"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <use href={`#${item.icon}`} />
                    </svg>
                    <span class="font-mono text-xs tracking-wider text-steel-500 uppercase transition-colors group-hover:text-navy-900">
                      {item.name}
                    </span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 lg:pb-16">
    <p class="text-center font-mono text-xs tracking-[0.2em] text-navy-900/50 uppercase">¿NO VES TU STACK AQUÍ?</p>
    <p class="mx-auto mt-3 max-w-2xl text-center text-lg text-navy-900">Mi perfil es de ingeniero. Mi valor radica en diseñar sistemas robustos; las herramientas cambian, los fundamentos, arquitecturas y las buenas prácticas permanecen.</p>
  </div>
</section>
