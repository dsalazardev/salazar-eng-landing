---
import { Menu, X } from '@lucide/astro';
import Button from '../ui/Button.astro';

interface NavLink {
  href: string;
  label: string;
  index: string;
}

const links: NavLink[] = [
  { href: '#servicios', label: 'Servicios', index: '05' },
  { href: '#casos', label: 'Casos', index: '06' },
  { href: '#proceso', label: 'Proceso', index: '07' },
  { href: '#faq', label: 'FAQ', index: '10' },
];
---

<header class="sticky top-0 z-40">
  {/* Franja de estado — anotaciones técnicas decorativas */}
  <div aria-hidden="true" class="hidden border-b border-line bg-surface md:block">
    <div class="mx-auto flex h-7 max-w-6xl items-center justify-between px-4 sm:px-6">
      <span class="tech-label">SYS_STATUS: OPERATIONAL</span>
      <span class="tech-label hidden lg:inline">LATAM / UTC-5</span>
      <span class="tech-label">CALIBRATED // SYS_2026</span>
    </div>
  </div>

  <div
    class="relative border-b border-line bg-surface supports-[backdrop-filter]:bg-surface/80 backdrop-blur-sm"
  >
    <nav
      aria-label="Principal"
      class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
    >
      {/* TODO: reemplazar el wordmark textual por el isotipo + logo SVG exportado desde ARCHIVOS/LOGO/AI/ */}
      <a href="/" class="flex items-baseline gap-1.5 text-lg font-bold tracking-tight text-navy-900">
        SALAZAR <span class="font-mono text-sm font-medium text-steel-500">Eng.</span>
      </a>

      <ul class="hidden items-center gap-6 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-semibold text-navy-900 transition-colors hover:text-accent"
              >
                <span
                  aria-hidden="true"
                  class="mr-1.5 font-mono text-[10px] text-steel-500"
                >{link.index}/</span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <Button href="#contacto">
          <span class="sm:hidden">Agendar</span>
          <span class="hidden sm:inline">Agendar diagnóstico</span>
        </Button>

        <button
          type="button"
          popovertarget="menu-movil"
          aria-label="Menú"
          class="nav-toggle flex min-h-11 min-w-11 items-center justify-center rounded-md text-navy-900 transition-colors hover:text-accent md:hidden"
        >
          <Menu class="nav-icon-menu size-5" aria-hidden="true" />
          <X class="nav-icon-close hidden size-5" aria-hidden="true" />
        </button>
      </div>
    </nav>
  </div>

  <div
    id="menu-movil"
    popover="auto"
    class="fixed inset-x-0 top-16 bottom-0 m-0 h-auto w-auto overflow-y-auto overscroll-contain border-0 bg-surface p-0 text-navy-900 md:hidden"
  >
    <nav aria-label="Menú móvil" class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
      <ul class="flex flex-col gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-md px-3 py-3 text-base font-semibold text-navy-900 transition-colors hover:bg-navy-900/5 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.getElementById('menu-movil');
    menu?.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.hidePopover?.();
      }
    });
  })();
</script>

<style is:global>
  header:has(#menu-movil:popover-open) .nav-icon-menu {
    display: none;
  }

  header:has(#menu-movil:popover-open) .nav-icon-close {
    display: block;
  }

  html:has(#menu-movil:popover-open) {
    overflow: hidden;
  }

  @supports not selector(:popover-open) {
    .nav-toggle[popovertarget] {
      display: none;
    }

    #menu-movil {
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0;
      border: 0;
      padding: 0;
      overflow: visible;
      background: transparent;
    }
  }
</style>
