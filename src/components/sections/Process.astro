---
import SectionLabel from '../ui/SectionLabel.astro';

interface ProcessStep {
  code: string;
  title: string;
  description: string;
}

const steps: ProcessStep[] = [
  {
    code: '01',
    title: 'Diagnóstico',
    description:
      'Diagnóstico técnico de 20 minutos, sin costo ni compromiso. Salimos con un plan claro, lo trabajemos o no.',
  },
  {
    code: '02',
    title: 'Propuesta',
    description:
      'Cotización por alcance cerrado y fases: qué se construye, en qué orden y a qué precio, antes de empezar.',
  },
  {
    code: '03',
    title: 'Sprints con demos',
    description:
      'Construcción por sprints con demos periódicas del avance, con código testeado en cada entrega.',
  },
  {
    code: '04',
    title: 'Entrega + soporte',
    description:
      'Plataforma en producción, con documentación y traspaso al equipo. Todo proyecto incluye un periodo de soporte.',
  },
];
---

<section id="proceso">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <SectionLabel index="07" text="PROCESO" />

    <h2 class="mt-6 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">
      Cómo trabajamos
    </h2>
    <p class="mt-3 text-steel-500">Diagnóstico primero; cotización por alcance cerrado y fases.</p>

    <ol class="relative mt-10 grid lg:grid-cols-4 lg:gap-10">
      <span
        class="pointer-events-none absolute top-3 right-0 left-0 hidden h-px bg-line lg:block"
        aria-hidden="true"></span>

      {
        steps.map((step, index) => (
          <li class="relative grid grid-cols-[auto_1fr] gap-x-4 lg:block">
            <div class="flex flex-col items-center lg:items-start">
              <span
                class="flex h-6 w-6 items-center justify-center border border-line bg-surface font-mono text-xs text-steel-500"
                aria-hidden="true"
              >
                {step.code}
              </span>
              {index < steps.length - 1 && (
                <span class="w-px flex-1 bg-line lg:hidden" aria-hidden="true" />
              )}
            </div>

            <div class="pb-8 lg:mt-4 lg:pb-0">
              <h3 class="text-base font-bold text-navy-900">{step.title}</h3>
              <p class="mt-2 text-sm text-steel-500">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
