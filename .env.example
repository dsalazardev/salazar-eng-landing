# Endpoint del formulario del lead magnet (backend ms-notifier-webhook, Render).
# Copiar este archivo a `.env` (sin versionar) para desarrollo local.
#
# IMPORTANTE — variable de BUILD-TIME: Astro inlinea PUBLIC_* en el bundle del
# cliente durante el build. Cambiar el valor exige re-build/re-deploy; no se lee
# en runtime. En el host (Cloudflare Pages/Vercel), definirla en el entorno de
# build. Antes del deploy de producción, agregar el dominio final al allowlist
# CORS_ORIGINS del backend.
PUBLIC_LEAD_ENDPOINT=https://ms-notifier-webhook.onrender.com/api/v1/lead

# URL/link de agendamiento de Cal.com (ej. https://cal.com/<usuario>/<evento>).
# La define el dueño cuando cree la cuenta; sin ella el CTA final cae a email.
# Misma naturaleza BUILD-TIME que PUBLIC_LEAD_ENDPOINT (cambiarla exige rebuild).
PUBLIC_BOOKING_URL=
